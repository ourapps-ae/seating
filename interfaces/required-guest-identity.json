          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Deps"
          }
        },
        {
          "name": "settings",
          "description": "Defaults to nameMinLength 1, nameMaxLength 20, tokenRotationSeconds 0.",
          "required": false,
          "schema": {
            "$ref": "#/components/schemas/IdentitySettings"
          }
        },
        {
          "name": "token",
          "description": "The token the device holds for this name; needed to take back a name in use. Defaults to none.",
          "required": false,
          "schema": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      ],
      "result": {
        "name": "result",
        "schema": {
          "description": "badName when the name is not acceptable; nameTaken when the name is in use and the token is not its own.",
