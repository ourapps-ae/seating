          "nameMaxLength": {
            "type": "integer",
            "description": "Longest name; not below nameMinLength. Defaults to 20.",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "tokenRotationSeconds": {
            "type": "integer",
            "description": "Age after which a token is swapped on its next use, and for which the replaced token is still accepted; 0 never rotates. Defaults to 0.",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "nameMinLength",
          "nameMaxLength",
          "tokenRotationSeconds"
