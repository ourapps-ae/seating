    {
      "name": "claim",
      "description": "Takes the name: a new guest (deps.newId) for a free name, or the guest returning with the name's current token (or the one it replaced, within the rotation period). Issues a new token; the previous one stops working. A name in use without its token is refused (nameTaken).",
      "params": [
        {
          "name": "book",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/IdentityBook"
          }
        },
        {
